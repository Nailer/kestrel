# Otari hosted gateway (create the key at https://otari.ai -> API Keys; starts with otk_)
OTARI_API_KEY=
# EU accounts: https://eu.api.otari.ai/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1

# Service key (dashboard -> API keys -> Create key -> Service key): enables per-seat budgets
OTARI_SERVICE_KEY=

# Optional custom prompt-injection guardrail (our own service, called by Otari)
KESTREL_GUARDRAIL_URL=
